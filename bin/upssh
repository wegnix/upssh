#!/bin/bash
# upssh-plugin-id: io.github.wegnix.upssh
# ^ Marcador de propriedade. O instalador e o desinstalador só tocam num
#   ~/.local/bin/upssh que tenha esta linha ou que aponte para a pasta do
#   plugin — um comando alheio com o mesmo nome fica intacto.

# upSSH — gestor de acessos SSH para o Omarchy: grupos, login por chave ou
# por senha, com as senhas num cofre GPG AES-256.
# omarchy:args=[connect <id>|add|edit|remove|list|passwd|groups|menu-sync|vault-init|master]

set -uo pipefail

# Tudo o que este script cria (config, cofre, exportações, temporários) é só
# do utilizador desde o primeiro byte, sem janela entre criar e fazer chmod.
umask 077

# Caminho absoluto deste script. As entradas geradas no menu do Omarchy
# apontam para aqui, e não para "upssh", porque quem instala com
# `omarchy plugin add` fica com o comando dentro da pasta do plugin e não no
# PATH.
SELF=$(readlink -f "${BASH_SOURCE[0]}")

CONFIG_DIR="${UPSSH_DIR:-$HOME/.config/upssh}"
SERVERS="$CONFIG_DIR/servers.json"
SECRETS="$CONFIG_DIR/secrets.gpg"
PENDING="$CONFIG_DIR/pending-secrets.json"
MENU_FILE="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
BEGIN_MARK="  // >>> upssh (gerado automaticamente - nao editar) >>>"
END_MARK="  // <<< upssh <<<"

MASTER=""

# O pinentry precisa de saber o terminal quando é chamado a partir de um.
[[ -t 0 ]] && export GPG_TTY="${GPG_TTY:-$(tty 2>/dev/null)}"

# Omarchy exports theme-matched gum styling; pick it up when available.
if command -v omarchy-restart-gum >/dev/null 2>&1; then
  source omarchy-restart-gum >/dev/null 2>&1 || true
fi

# ---------------------------------------------------------------- traduções

CONFIG_FILE="$CONFIG_DIR/config.json"

# Idioma: o que estiver em config.json manda; sem isso segue o $LANG do
# sistema, e na dúvida fica em inglês.
detect_lang() {
  local l
  if [[ -f $CONFIG_FILE ]]; then
    l=$(jq -r '.lang // empty' "$CONFIG_FILE" 2>/dev/null)
    [[ $l == pt || $l == en ]] && { printf '%s' "$l"; return; }
  fi
  case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
  pt_* | pt) printf 'pt' ;;
  *) printf 'en' ;;
  esac
}

UPSSH_LANG=$(detect_lang)

set_lang() {
  local l="${1:-}"
  [[ $l == pt || $l == en ]] || { printf '%s\n' "$(t bad_lang "$l")" >&2; return 2; }
  mkdir -p "$CONFIG_DIR"
  store_lock || return 1
  local tmp
  tmp=$(mktemp "$CONFIG_DIR/.cfg.XXXXXX") || return 1
  if [[ -f $CONFIG_FILE ]]; then
    jq --arg l "$l" '.lang = $l' "$CONFIG_FILE" >"$tmp" || { rm -f "$tmp"; return 1; }
  else
    jq -n --arg l "$l" '{lang: $l}' >"$tmp" || { rm -f "$tmp"; return 1; }
  fi
  chmod 600 "$tmp"
  mv "$tmp" "$CONFIG_FILE"
  UPSSH_LANG="$l"
  menu_sync >/dev/null 2>&1
}

