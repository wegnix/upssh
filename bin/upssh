# t <chave> [args...] — devolve a mensagem traduzida, com printf por baixo,
# para os %s entrarem na ordem certa em qualquer idioma.
t() {
  local key="$1"
  shift
  local fmt
  if [[ $UPSSH_LANG == pt ]]; then
    fmt="${MSG_pt[$key]-}"
  else
    fmt="${MSG_en[$key]-}"
  fi
  [[ -n $fmt ]] || fmt="${MSG_en[$key]-$key}"
  # shellcheck disable=SC2059
  printf "$fmt" "$@"
}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

warn() { has_tty && gum style --foreground 3 "$*" || printf '%s\n' "$*" >&2; }
err() { has_tty && gum style --foreground 1 "$*" || printf '%s\n' "$*" >&2; }
has_tty() { [[ -t 0 && -t 1 ]]; }

# Um caminho pertence-nos se for um link para este script ou se o ficheiro
# carregar o marcador do plugin. Tudo o resto é de outra pessoa.
upssh_owns() {
  local path="$1" resolved
  [[ -e $path || -L $path ]] || return 1
  resolved=$(readlink -f "$path" 2>/dev/null) || return 1
  [[ $resolved == "$SELF" ]] && return 0
  # O marcador só existe a partir da 1.0.2; as versões anteriores reconhecem-se
  # por esta constante, que mais nada usa.
  grep -qm1 -e '^# upssh-plugin-id: io.github.wegnix.upssh$' \
    -e '^EXPORT_MAGIC="upssh-export"$' "$resolved" 2>/dev/null
}

# Mantém a janela aberta quando algo corre mal, para a mensagem ser legível.
hold() { has_tty && read -n1 -rs -p "$(t press_enter)" && echo; }

ok() { has_tty && gum style --foreground 2 "$*" || printf '%s\n' "$*"; }

# Pede um segredo. Com terminal usa o gum; sem terminal (widget da barra, `!`
# no Claude Code, hook) cai no pinentry gráfico, que abre a sua própria janela.
ask_secret() {
  local prompt="$1" out pin
  # Chamada sempre dentro de $(...), por isso o stdout nunca é um terminal;
  # o gum desenha no stderr, e é esse que conta.
  if [[ -t 0 && -t 2 ]]; then
    gum input --password --header "$prompt"
    return $?
  fi
  local pe
  pe=$(command -v pinentry-gnome3 || command -v pinentry-gtk || command -v pinentry-qt || command -v pinentry) ||
    { printf '%s\n' "$(t no_tty_pinentry)" >&2; return 1; }
  out=$(printf 'SETTITLE upSSH\nSETPROMPT %s\nSETDESC %s\nGETPIN\nBYE\n' \
    "$(t pin_label)" "$prompt" | "$pe" 2>/dev/null)
  pin=$(awk '/^D /{ print substr($0, 3); found=1 } END { exit !found }' <<<"$out") || return 1
  # pinentry devolve o valor com percent-encoding (%25, %0A, ...).
  printf '%s' "$pin" | python3 -c 'import sys,re; d=sys.stdin.read(); sys.stdout.write(re.sub(r"%([0-9A-Fa-f]{2})", lambda m: chr(int(m.group(1), 16)), d))'
}

require() {
  local missing=()
  for c in "$@"; do command -v "$c" >/dev/null 2>&1 || missing+=("$c"); done
  ((${#missing[@]})) && die "$(t missing_deps "${missing[*]}")"
}

slugify() {
  printf '%s' "$1" |
    iconv -t ascii//TRANSLIT 2>/dev/null |
    tr '[:upper:]' '[:lower:]' |
    sed -e 's/[^a-z0-9]\+/-/g' -e 's/^-\+//' -e 's/-\+$//' |
    cut -c1-48 | sed 's/-\+$//'
}

# ------------------------------------------------------------------ validação
# need_value "$@": a opção em $1 tem de trazer um valor em $2 (senão o
# `shift 2` falhava e o ciclo de argumentos nunca terminava).
need_value() {
  (($# >= 2)) && return 0
  printf '%s\n' "$(t missing_value "$1")" >&2
  return 1
}

# Os ids entram em chaves do menu do Omarchy e em linhas de comando; só este
# formato é aceite, venha o valor do formulário, do painel ou de um ficheiro.
valid_id() { [[ $1 =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]]; }

# Host e utilizador vão parar ao argv do ssh: sem espaços, sem caracteres de
# controlo e sem um '-' inicial, que o ssh leria como opção.
valid_endpoint() { [[ -n $1 && $1 != -* && ! $1 =~ [[:space:][:cntrl:]] ]]; }

valid_port() { [[ $1 =~ ^[0-9]{1,5}$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535)); }

# Texto livre (nome, grupo, caminho da chave, opções) sem caracteres de
# controlo, que num terminal serviriam para injectar sequências de escape, nem
# marcas bidireccionais, que deixam um nome parecer outro.
JQ_CLEAN='def c: tostring | gsub("[[:cntrl:]\u200e\u200f\u202a-\u202e\u2066-\u2069]"; "");'

strip_cntrl() { jq -rnj --arg v "$1" "$JQ_CLEAN"' $v | c'; }

# Nenhum ficheiro nosso chega perto disto; um maior não é lido.
MAX_FILE=1048576

check_size() {
  local f="$1" n
  [[ -f $f ]] || return 0
  n=$(stat -c %s -- "$f" 2>/dev/null) || return 1
  ((n <= MAX_FILE)) || { err "$(t store_too_big "$f")"; return 1; }
}

ensure_store() {
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR"
  if [[ ! -f $SERVERS ]]; then
    printf '%s\n' '{"version":1,"servers":[]}' >"$SERVERS"
  fi
  check_size "$SERVERS" || exit 1
}

# Um só escritor de cada vez: o painel e a TUI fazem ler-alterar-gravar sobre
# os mesmos ficheiros. O lock vive no fd 9 até ao fim do processo (comandos
# da API) ou até store_unlock (entre acções da TUI).
STORE_LOCKED=false

store_lock() {
  [[ $STORE_LOCKED == true ]] && return 0
  exec 9>>"$CONFIG_DIR/.lock" || return 1
  if ! flock -w 30 9; then
    exec 9>&-
    err "$(t store_busy)"
    return 1
  fi
  STORE_LOCKED=true
}

store_unlock() {
  [[ $STORE_LOCKED == true ]] || return 0
  flock -u 9 2>/dev/null
  exec 9>&-
  STORE_LOCKED=false
}

save_servers() {
  local tmp
  tmp=$(mktemp "$CONFIG_DIR/.servers.XXXXXX") || return 1
  cat >"$tmp" || { rm -f "$tmp"; return 1; }
  jq -e '(.servers | type) == "array"' "$tmp" >/dev/null 2>&1 || { rm -f "$tmp"; err "$(t invalid_json)"; return 1; }
  chmod 600 "$tmp"
  mv "$tmp" "$SERVERS"
}

# Ids cuja senha no cofre já não pode ser usada: o servidor foi apagado sem
# o cofre abrir, ou um import trocou-lhe o destino. Enquanto aqui estiverem,
# a senha não é enviada e o id não é reaproveitado; a próxima escrita no
# cofre apaga-as e limpa a lista.
stale_ids() { jq -c '.staleSecrets // []' "$SERVERS"; }

is_stale() { jq -e --arg id "$1" '(.staleSecrets // []) | index($id) != null' "$SERVERS" >/dev/null 2>&1; }

stale_clear() {
  jq -e 'has("staleSecrets")' "$SERVERS" >/dev/null 2>&1 || return 0
  jq 'del(.staleSecrets)' "$SERVERS" | save_servers
}

# ---------------------------------------------------------------- cofre (gpg)

# Leitura: sem MASTER em memória deixa-se o gpg-agent tratar do pedido e da
# cache — a senha mestra fica na memória protegida do agente, nunca neste
# processo, e as ligações seguintes não voltam a pedi-la enquanto o TTL durar.
# Com MASTER (fluxos de escrita) usa-se o modo loopback, que não mexe na cache.
secrets_read() {
  # 9>&-: um gpg-agent arrancado aqui não pode herdar o fd do lock.
  if [[ -n $MASTER ]]; then
    gpg --quiet --batch --yes --pinentry-mode loopback --passphrase-fd 3 \
      --decrypt "$SECRETS" 3<<<"$MASTER" 2>/dev/null 9>&-
  else
    gpg --quiet --decrypt "$SECRETS" 2>/dev/null 9>&-
  fi
}

# Grava o stdin no cofre — mas só se for um objecto JSON de strings. Um jq
# que falhe a montante entrega um stdin vazio, e cifrar isso apagaria todas
# as senhas; nesse caso o cofre fica exactamente como estava.
secrets_write() {
  local plain tmp
  plain=$(cat) || return 1
  if ! jq -e 'type == "object" and all(.[]; type == "string")' >/dev/null 2>&1 <<<"$plain"; then
    err "$(t vault_bad_data)"
    return 1
  fi
  tmp=$(mktemp "$CONFIG_DIR/.secrets.XXXXXX") || return 1
  if printf '%s' "$plain" | gpg --quiet --batch --yes --pinentry-mode loopback --passphrase-fd 3 \
    --symmetric --cipher-algo AES256 --output "$tmp" 3<<<"$MASTER" 9>&-; then
    chmod 600 "$tmp"
    mv "$tmp" "$SECRETS"
  else
    rm -f "$tmp"
    return 1
  fi
}

vault_create() {
  local a b
  a=$(ask_secret "$(t master_create)") || return 1
  b=$(ask_secret "$(t master_confirm)") || return 1
  [[ -n $a && $a == "$b" ]] || { err "$(t pass_mismatch)"; return 1; }
  MASTER="$a"
  printf '%s' '{}' | secrets_write || { MASTER=""; return 1; }
  ok "$(t vault_created "$SECRETS")"
}

unlock() {
  [[ -n $MASTER ]] && return 0
  if [[ ! -f $SECRETS ]]; then
    vault_create
    return
  fi
  local i
  for i in 1 2 3; do
    MASTER=$(ask_secret "$(t master_prompt)") || { MASTER=""; return 1; }
    secrets_read >/dev/null 2>&1 && return 0
    err "$(t wrong_pass)"
    MASTER=""
  done
  return 1
}

get_password() {
  [[ -f $SECRETS ]] || return 1
  is_stale "$1" && return 1
  secrets_read | jq -r --arg id "$1" '.[$id] // empty'
}

# vault_update <filtro jq> [argumentos jq...]
# Aplica o filtro ao cofre decifrado, depois de lhe tirar as senhas
# marcadas como obsoletas. Segredos entram nos argumentos só como caminhos
# (--rawfile/--slurpfile sobre um pipe), nunca como texto no argv, que
# qualquer utilizador lê em /proc/<pid>/cmdline.
vault_update() {
  local filter="$1"
  shift
  unlock || return 1
  local cur
  cur=$(secrets_read) || { err "$(t vault_read_fail)"; return 1; }
  [[ -n $cur ]] || cur='{}'
  printf '%s' "$cur" |
    jq "$@" --argjson stale "$(stale_ids)" "del(.[\$stale[]]) | $filter" 2>/dev/null |
    secrets_write || return 1
  stale_clear
}

set_password() {
  vault_update '.[$id] = $pw' --arg id "$1" --rawfile pw <(printf '%s' "$2")
}

del_password() {
  [[ -f $SECRETS ]] || return 0
  vault_update 'del(.[$id])' --arg id "$1"
}

change_master() {
  [[ -f $SECRETS ]] || { vault_create; return; }
  store_lock || return 1
  unlock || return 1
  local plain a b
  plain=$(secrets_read) || { err "$(t vault_read_fail)"; return 1; }
  a=$(ask_secret "$(t master_new)") || return 1
  b=$(ask_secret "$(t master_new_confirm)") || return 1
  [[ -n $a && $a == "$b" ]] || { err "$(t pass_mismatch)"; return 1; }
  MASTER="$a"
  printf '%s' "$plain" | secrets_write && ok "$(t master_changed)"
}

# Importa um ficheiro de senhas em texto limpo para dentro do cofre e apaga-o.
vault_init() {
  ensure_store
  store_lock || return 1
  if [[ ! -f $SECRETS ]]; then
    vault_create || return 1
  else
    unlock || return 1
  fi
  if [[ -f $PENDING ]]; then
    check_size "$PENDING" || return 1
    if ! jq -e -s 'length == 1 and (.[0] | type == "object" and all(.[]; type == "string"))' "$PENDING" >/dev/null 2>&1; then
      err "$(t pending_fail)"
      return 1
    fi
    if vault_update '. * $p[0]' --slurpfile p "$PENDING"; then
      shred -u "$PENDING" 2>/dev/null || rm -f "$PENDING"
      ok "$(t pending_imported)"
    else
      err "$(t pending_fail)"
      return 1
    fi
  fi
  ok "$(t vault_ready)"
}

# ------------------------------------------------------------------- consulta

server_json() { jq -c --arg id "$1" '.servers[] | select(.id == $id)' "$SERVERS"; }

server_exists() { [[ -n $(server_json "$1") ]]; }

groups_list() { jq -r "$JQ_CLEAN"' [.servers[].group | strings | c] | unique | .[]' "$SERVERS"; }

# id_taken <id> [json]: ocupado por um servidor ou por uma senha obsoleta
# ainda por apagar — reaproveitá-lo faria essa senha seguir para outro host.
id_taken() {
  local filter='any(.servers[]; .id == $id) or ((.staleSecrets // []) | index($id) != null)'
  if (($# > 1)); then
    jq -e --arg id "$1" "$filter" >/dev/null 2>&1 <<<"$2"
  else
    jq -e --arg id "$1" "$filter" "$SERVERS" >/dev/null 2>&1
  fi
}

# new_id <nome> [json]
new_id() {
  local base id n=2
  base=$(slugify "$1")
  valid_id "$base" || base="servidor"
  id="$base"
  while id_taken "$id" "${@:2}"; do
    id="$base-$n"
    ((n++))
  done
  printf '%s' "$id"
}

# Campos mostrados no terminal passam por aqui: um nome importado não pode
# trazer sequências de escape.

cmd_list() {
  ensure_store
  {
    printf '%s\t%s\t%s\tAUTH\t%s\n' "$(t col_group)" "$(t col_name)" "$(t col_dest)" "$(t col_id)"
    jq -r "$JQ_CLEAN"' .servers | sort_by(.group, .name) | .[] |
      [(.group|c), (.name|c), ((.user|c) + "@" + (.host|c) + ":" + (.port|c)), (.auth|c), (.id|c)] | @tsv' "$SERVERS"
  } | column -t -s $'\t'
}

confirm() {
  has_tty || return 1
  gum confirm "$*" --default=no
}

# Primeiro acesso a um host: em vez de deixar o ssh falhar (o sshpass nem
# chega a mostrar o pedido), mostra-se a impressão digital da chave e pede-se
# confirmação antes de a gravar. É o mesmo grau de confiança que responder
# "yes" ao ssh, mas com a impressão digital à vista.
ensure_host_key() {
  local host="$1" port="$2" target scan
  [[ $port == 22 ]] && target="$host" || target="[$host]:$port"
  ssh-keygen -F "$target" >/dev/null 2>&1 && return 0

  scan=$(ssh-keyscan -p "$port" -T 8 -- "$host" 2>/dev/null | grep -v '^#')
  if [[ -z $scan ]]; then
    # Alias do ssh_config, ProxyJump, known_hosts global...: o ssh sabe
    # resolver o que o keyscan não alcança, por isso a decisão fica com ele.
    warn "$(t hostkey_unverified "$host" "$port")"
    return 0
  fi

  warn "$(t hostkey_first "$host" "$port")"
  printf '%s\n' "$scan" | ssh-keygen -lf - 2>/dev/null | sed 's/^/  /'
  if ! confirm "$(t hostkey_trust)"; then
    err "$(t hostkey_declined)"
    return 1
  fi

  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  printf '%s\n' "$scan" >>"$HOME/.ssh/known_hosts"
  chmod 600 "$HOME/.ssh/known_hosts"
  ok "$(t hostkey_saved)"
}

# ------------------------------------------------------------------- ligação

cmd_connect() {
  local id="${1:-}"
  [[ -n $id ]] || die "$(t usage_connect)"
  valid_id "$id" || die "$(t bad_id "$(strip_cntrl "$id")")"
  ensure_store
  local s
  s=$(server_json "$id")
  [[ -n $s ]] || die "$(t not_found "$id")"

  local name host port user auth identity options
  name=$(jq -r "$JQ_CLEAN"' .name | c' <<<"$s")
  host=$(jq -r '.host' <<<"$s")
  port=$(jq -r '.port' <<<"$s")
  user=$(jq -r '.user' <<<"$s")
  auth=$(jq -r '.auth' <<<"$s")
  identity=$(jq -r '.identity // ""' <<<"$s")
  options=$(jq -r '.options // ""' <<<"$s")

  # Dados antigos ou editados à mão passam pela mesma validação do cadastro.
  valid_endpoint "$host" || { err "$(t bad_field host "$(strip_cntrl "$host")")"; hold; return 1; }
  valid_endpoint "$user" || { err "$(t bad_field user "$(strip_cntrl "$user")")"; hold; return 1; }
  valid_port "$port" || { err "$(t bad_port "$(strip_cntrl "$port")")"; hold; return 1; }

  # Só o login por senha precisa disto: debaixo do sshpass o ssh não
  # consegue perguntar pela chave. Com chave, o próprio ssh pergunta.
  if [[ $auth == password ]]; then
    ensure_host_key "$host" "$port" || { hold; return 1; }
  fi

  local -a cmd=(ssh)
  if [[ -n $options ]]; then
    local -a extra
    read -ra extra <<<"$options"
    cmd+=("${extra[@]}")
  fi
  cmd+=(-p "$port")
  if [[ -n $identity ]]; then
    local keyfile="${identity/#\~/$HOME}" real mode
    if [[ ! -f $keyfile ]]; then
      err "$(t key_missing "$keyfile")"
      hold
      return 1
    fi
    # O ssh recusa chaves legíveis por outros. Pastas sincronizadas (Nextcloud,
    # Dropbox) repõem 0644 com frequência, por isso corrige-se a cada ligação —
    # mas só dentro de ~/.ssh e em ficheiros nossos; fora disso apenas avisa.
    real=$(readlink -f -- "$keyfile")
    mode=$(stat -c '%a' -- "$real")
    if [[ $mode != 600 && $mode != 400 ]]; then
      if [[ $real == "$(readlink -f -- "$HOME/.ssh")/"* && -O $real ]]; then
        chmod 600 -- "$real" && warn "$(t key_perms_fixed "$keyfile")"
      else
        warn "$(t key_perms_skip "$keyfile" "$mode")"
      fi
    fi
    cmd+=(-i "$keyfile")
  fi
  # "--" fecha as opções: o destino nunca é lido como uma.
  cmd+=(-- "$user@$host")

  printf '\033]0;%s\007' "$name"
  gum style --border rounded --padding "0 2" --margin "1 0" --border-foreground 4 \
    "$name" "$user@$host:$port"

  if [[ $auth == password ]]; then
    local pw
    pw=$(get_password "$id")
    if [[ -n $pw ]]; then
      SSHPASS="$pw" sshpass -e "${cmd[@]}"
      local rc=$?
      case $rc in
      0 | 1 | 130) ;;
      5) err "$(t pass_refused "$host")"; hold ;;
      6) err "$(t hostkey_unknown "$host" "$port")"; hold ;;
      *) err "$(t conn_error "$rc")"; hold ;;
      esac
      return $rc
    fi
    warn "$(t no_stored_pass "$id")"
  fi
  "${cmd[@]}"
  local rc=$?
  ((rc != 0)) && { err "$(t conn_error "$rc")"; hold; }
  return $rc
}

# ------------------------------------------------------------------- cadastro

pick_group() {
  local -a opts=()
  mapfile -t opts < <(groups_list)
  opts+=("$(t group_new_option)")
  local sel
  sel=$(printf '%s\n' "${opts[@]}" | gum choose --header "${1:-$(t f_group)}") || return 1
  if [[ $sel == "$(t group_new_option)" ]]; then
    sel=$(gum input --header "$(t group_new_name)" --placeholder "$(t ph_group)") || return 1
    [[ -n $sel ]] || return 1
  fi
  printf '%s' "$sel"
}

# write_server <id|vazio> <nome> <grupo> <host> <porta> <utilizador> <auth>
#              <identidade> <opções>
# Único caminho de escrita de um servidor (TUI, painel): valida tudo, grava
# e imprime o id final. Devolve 2 quando um campo é inválido.
write_server() {
  local id="$1" name group host="$4" port="${5:-22}" user="$6" auth="$7" identity options
  name=$(strip_cntrl "$2")
  group=$(strip_cntrl "$3")
  identity=$(strip_cntrl "$8")
  options=$(strip_cntrl "$9")
  [[ -n ${name//[[:space:]]/} ]] || { err "$(t req_name)"; return 2; }
  [[ -n ${group//[[:space:]]/} ]] || group="Geral"
  valid_endpoint "$host" || { err "$(t bad_field host "$(strip_cntrl "$host")")"; return 2; }
  valid_endpoint "$user" || { err "$(t bad_field user "$(strip_cntrl "$user")")"; return 2; }
  valid_port "$port" || { err "$(t bad_port "$(strip_cntrl "$port")")"; return 2; }
  port=$((10#$port))
  [[ $auth == password ]] || auth=key
  [[ $auth == key ]] || identity=""
  if [[ -n $id ]]; then
    valid_id "$id" || { err "$(t bad_id "$(strip_cntrl "$id")")"; return 2; }
  fi

  store_lock || return 1
  [[ -n $id ]] || id=$(new_id "$name")

  jq --arg id "$id" --arg name "$name" --arg group "$group" --arg host "$host" \
    --argjson port "$port" --arg user "$user" --arg auth "$auth" \
    --arg identity "$identity" --arg options "$options" '
      .servers = ((.servers // []) | map(select(.id != $id))) + [{
        id: $id, name: $name, group: $group, host: $host, port: $port,
        user: $user, auth: $auth, identity: $identity, options: $options
      }] | .servers |= sort_by(.group, .name)
    ' "$SERVERS" | save_servers || return 1
  printf '%s' "$id"
}

# form <id-ou-vazio>
server_form() {
  local id="${1:-}" cur='{}'
  [[ -n $id ]] && cur=$(server_json "$id")

  local d_name d_group d_host d_port d_user d_auth d_identity d_options
  d_name=$(jq -r '.name // ""' <<<"$cur")
  d_group=$(jq -r '.group // ""' <<<"$cur")
  d_host=$(jq -r '.host // ""' <<<"$cur")
  d_port=$(jq -r '.port // 22' <<<"$cur")
  d_user=$(jq -r '.user // "root"' <<<"$cur")
  d_auth=$(jq -r '.auth // "key"' <<<"$cur")
  d_identity=$(jq -r '.identity // ""' <<<"$cur")
  d_options=$(jq -r '.options // ""' <<<"$cur")

  local name group host port user auth identity options
  name=$(gum input --header "$(t f_name)" --value "$d_name" --placeholder "$(t ph_name)") || return 1
  [[ -n $name ]] || { err "$(t req_name)"; return 1; }

  if [[ -n $d_group ]] && gum confirm "$(t keep_group "$d_group")" --default=yes; then
    group="$d_group"
  else
    group=$(pick_group "$(t f_group)") || return 1
  fi

  host=$(gum input --header "$(t f_host)" --value "$d_host" --placeholder "10.0.0.1") || return 1
  [[ -n $host ]] || { err "$(t req_host)"; return 1; }

  port=$(gum input --header "$(t f_port)" --value "$d_port") || return 1
  port=${port:-22}
  valid_port "$port" || { err "$(t bad_port "$port")"; return 1; }

  user=$(gum input --header "$(t f_user)" --value "$d_user") || return 1
  [[ -n $user ]] || { err "$(t req_user)"; return 1; }

  local auth_label
  auth_label=$(printf '%s\n%s\n' "$(t auth_key)" "$(t auth_pass)" |
    gum choose --header "$(t f_auth)" \
      --selected "$([[ $d_auth == password ]] && t auth_pass || t auth_key)") || return 1
  [[ $auth_label == "$(t auth_pass)" ]] && auth=password || auth=key

  identity=""
  if [[ $auth == key ]]; then
    identity=$(gum input --header "$(t f_identity)" \
      --value "$d_identity" --placeholder "~/.ssh/id_ed25519") || return 1
  fi

  options=$(gum input --header "$(t f_options)" --value "$d_options" \
    --placeholder "-oHostKeyAlgorithms=+ssh-rsa") || return 1

  # O lock é tomado aqui, no processo principal: o $(...) corre numa subshell
  # e um lock tomado lá dentro soltava-se logo à saída.
  store_lock || return 1
  id=$(write_server "$id" "$name" "$group" "$host" "$port" "$user" "$auth" "$identity" "$options") || return 1

  if [[ $auth == password ]]; then
    local pw
    pw=$(ask_secret "$(t f_pass_for "$user" "$host")") || return 1
    [[ -n $pw ]] && { set_password "$id" "$pw" || err "$(t pass_save_fail)"; }
  fi

  menu_sync
  ok "$(t saved_as "$(strip_cntrl "$name")" "$id")"
}

pick_server_id() {
  local group="${1:-}" header="${2:-$(t which_edit)}"
  local -a rows=() labels=() ids=()
  mapfile -t rows < <(jq -r --arg g "$group" "$JQ_CLEAN"'
    .servers | sort_by(.group, .name) | .[] | select($g == "" or .group == $g) |
    [(.id|c), (.name|c), ((.user|c) + "@" + (.host|c) + ":" + (.port|c)), (.group|c), (.auth|c)] | @tsv' "$SERVERS")
  ((${#rows[@]})) || { warn "$(t no_servers)"; return 1; }

  local r id name addr grp auth mark
  for r in "${rows[@]}"; do
    IFS=$'\t' read -r id name addr grp auth <<<"$r"
    [[ $auth == password ]] && mark="" || mark=""
    if [[ -n $group ]]; then
      labels+=("$(printf '%s  %-26s %s' "$mark" "$name" "$addr")")
    else
      labels+=("$(printf '%s  %-12s %-26s %s' "$mark" "$grp" "$name" "$addr")")
    fi
    ids+=("$id")
  done

  local sel
  sel=$(printf '%s\n' "${labels[@]}" | gum filter --header "$header" --placeholder "$(t filter_ph)" --height 18) || return 1
  local i
  for i in "${!labels[@]}"; do
    [[ ${labels[$i]} == "$sel" ]] && { printf '%s' "${ids[$i]}"; return 0; }
  done
  return 1
}

# Tira o servidor e a senha dele. Se o cofre não abrir, o id fica marcado
# como obsoleto: a senha antiga não pode acabar num servidor novo que
# herde o mesmo id.
delete_server() {
  local id="$1"
  store_lock || return 1
  # Numa só escrita: o servidor sai e, havendo cofre, o id fica marcado.
  jq --arg id "$id" --argjson vault "$([[ -f $SECRETS ]] && echo true || echo false)" '
    .servers |= map(select(.id != $id))
    | if $vault then .staleSecrets = (((.staleSecrets // []) + [$id]) | unique) else . end
  ' "$SERVERS" | save_servers || return 1
  if [[ -f $SECRETS ]]; then
    del_password "$id" >/dev/null || warn "$(t delete_pass_fail)"
  fi
}

remove_server() {
  local id
  id=$(pick_server_id "" "$(t which_remove)") || return 1
  local name
  name=$(server_json "$id" | jq -r "$JQ_CLEAN"' .name | c')
  gum confirm "$(t confirm_remove "$name")" --default=no || return 0
  delete_server "$id" || return 1
  menu_sync
  ok "$(t removed "$name")"
}

set_server_password() {
  local id
  id=$(pick_server_id "" "$(t which_pass)") || return 1
  local pw
  pw=$(ask_secret "$(t new_pass)") || return 1
  [[ -n $pw ]] || { err "$(t empty_pass)"; return 1; }
  store_lock || return 1
  set_password "$id" "$pw" || return 1
  jq --arg id "$id" '.servers |= map(if .id == $id then .auth = "password" else . end)' "$SERVERS" | save_servers
  menu_sync
  ok "$(t pass_saved)"
}

rename_group() {
  local old new
  old=$(groups_list | gum choose --header "$(t which_group_rename)") || return 1
  new=$(gum input --header "$(t new_name)" --value "$old") || return 1
  new=$(strip_cntrl "$new")
  [[ -n $new ]] || return 1
  store_lock || return 1
  jq --arg o "$old" --arg n "$new" '.servers |= map(if .group == $o then .group = $n else . end) | .servers |= sort_by(.group, .name)' "$SERVERS" | save_servers || return 1
  menu_sync
  ok "$(t group_renamed "$new")"
}

move_server_group() {
  local id group
  id=$(pick_server_id "" "$(t which_move)") || return 1
  group=$(pick_group "$(t new_group)") || return 1
  group=$(strip_cntrl "$group")
  [[ -n $group ]] || return 1
  store_lock || return 1
  jq --arg id "$id" --arg g "$group" '.servers |= map(if .id == $id then .group = $g else . end) | .servers |= sort_by(.group, .name)' "$SERVERS" | save_servers || return 1
  menu_sync
  ok "$(t moved_to "$group")"
}

# -------------------------------------------------------------- menu Omarchy

menu_block() {
  # O menu do Omarchy congela a altura maxima na primeira lista aberta, por
  # isso a rota "upssh" lista todos os servidores (card alto e pesquisavel) e os
  # grupos ficam em "upssh._grupos", ja a herdar essa altura. As entradas
  # fixas começam por "_", que nenhum id de servidor pode ter.
  #
  # Tudo sai do jq: chaves e valores passam por tojson e os comandos por @sh,
  # por isso nenhum nome, grupo ou id consegue fechar uma string do JSONC nem
  # acrescentar comandos à acção que o menu corre com bash -lc.
  local -A used=()
  local slugs='[]' group slug base n
  while IFS= read -r group; do
    [[ -n $group ]] || continue
    base=$(slugify "$group")
    [[ -n $base ]] || base="grupo"
    slug="$base"
    n=2
    while [[ -n ${used[$slug]-} ]]; do
      slug="$base-$n"
      ((n++))
    done
    used[$slug]=1
    slugs=$(jq -c --arg g "$group" --arg s "$slug" '. + [[$g, $s]]' <<<"$slugs")
  done < <(groups_list)

  printf '%s\n' "$BEGIN_MARK"
  jq -r --arg self "$SELF" --argjson slugs "$slugs" \
    --arg rootDesc "$(t menu_root_desc)" --arg byGroup "$(t menu_bygroup)" \
    --arg byGroupDesc "$(t menu_bygroup_desc)" --arg manage "$(t menu_manage)" \
    --arg manageDesc "$(t menu_manage_desc)" "$JQ_CLEAN"'
    def launch($args): "omarchy-launch-tui --app-id=org.upssh " + ([$self] + $args | @sh);
    def entry($k; $v): "  " + ($k | tojson) + ": " + ($v | tojson) + ",";
    def dest: (.user|c) + "@" + (.host|c) + ":" + (.port|c);
    [.servers[] | select((.id | type) == "string" and (.id | test("^[a-z0-9][a-z0-9-]{0,63}$")))] as $srv |
    entry("upssh"; {icon: "", label: "upSSH", aliases: ["ssh", "servidores", "acessos", "remoto"], description: $rootDesc}),
    ($srv | sort_by(.group, .name) | .[] |
      entry("upssh." + .id; {icon: "", label: (.name|c), description: ((.group|c) + " · " + dest),
        aliases: [(.group|c), (.host|c)], action: launch(["connect", .id])})),
    entry("upssh._grupos"; {icon: "", label: $byGroup, description: $byGroupDesc}),
    ($slugs[] | .[0] as $g | .[1] as $s |
      entry("upssh._grupos." + $s; {icon: "", label: $g}),
      ($srv | map(select((.group|c) == $g)) | sort_by(.name) | .[] |
        entry("upssh._grupos." + $s + "." + .id; {icon: "", label: (.name|c), description: dest,
          action: launch(["connect", .id])}))),
    entry("upssh._gerir"; {icon: "", label: $manage, description: $manageDesc, action: launch([])})
  ' "$SERVERS" || return 1
  printf '%s\n' "$END_MARK"
}

# Reescreve o bloco do upSSH no menu do Omarchy. O trabalho está em
# MENU_MERGE_PY (python): tira o bloco antigo, insere o novo antes da
# chaveta que fecha a raiz e só devolve o resultado se o Omarchy o
# conseguir ler e se todas as entradas do utilizador lá continuarem.
menu_sync() {
  ensure_store
  store_lock || return 1
  local target dir mode block tmp rc
  # Um link (dotfiles) é seguido até ao ficheiro real, que é o que se
  # reescreve, e o link fica. Um link partido não é seguido.
  if [[ -L $MENU_FILE && ! -e $MENU_FILE ]]; then
    err "$(t menu_link_broken "$MENU_FILE")"
    return 1
  fi
  mkdir -p "$(dirname "$MENU_FILE")"
  target=$(readlink -f -- "$MENU_FILE") || return 1
  [[ -e $target ]] || printf '{\n}\n' >"$target" || return 1
  check_size "$target" || return 1
  mode=$(stat -c '%a' -- "$target") || return 1
  dir=$(dirname "$target")

  block=$(menu_block) || { err "$(t menu_sync_fail)"; return 1; }
  tmp=$(mktemp "$dir/.omarchy-menu.upssh.XXXXXX") || return 1
  BLOCK="$block" python3 -c "$MENU_MERGE_PY" "$target" >"$tmp"
  rc=$?
  case $rc in
  0) ;;
  3) rm -f "$tmp"; err "$(t menu_markers_broken "$MENU_FILE")"; return 1 ;;
  4) rm -f "$tmp"; err "$(t menu_file_invalid "$MENU_FILE")"; return 1 ;;
  *) rm -f "$tmp"; err "$(t menu_sync_fail)"; return 1 ;;
  esac
  if [[ ! -s $tmp ]]; then
    rm -f "$tmp"
    err "$(t menu_sync_fail)"
    return 1
  fi
  chmod "$mode" "$tmp"
  mv -f -T "$tmp" "$target"
}

# shellcheck disable=SC2016
MENU_MERGE_PY='
import json, os, re, sys

path = sys.argv[1]
block = os.environ["BLOCK"].rstrip("\n")
text = open(path, encoding="utf-8").read().replace("\r\n", "\n")

BEGIN, END = "// >>> upssh", "// <<< upssh"

# Os marcadores têm de vir em pares abre/fecha. Se o bloco estiver partido
# (editado à mão, colado pela metade), não há forma segura de saber onde
# acaba, e apagar até ao fim do ficheiro levaria entradas do utilizador.
# Nesse caso sai com 3 sem escrever nada e o ficheiro fica como está.
kinds = []
for line in text.split("\n"):
    t = line.strip()
    if t.startswith(BEGIN):
        kinds.append("begin")
    elif t.startswith(END):
        kinds.append("end")
if kinds != ["begin", "end"] * (len(kinds) // 2):
    sys.exit(3)

out, skip = [], False
for line in text.split("\n"):
    t = line.strip()
    if t.startswith(BEGIN):
        skip = True
    elif t.startswith(END):
        skip = False
    elif not skip:
        out.append(line)
text = "\n".join(out)


def root_close(t):
    """Posição da chaveta que fecha o objecto da raiz e do último caracter
    significativo antes dela, saltando strings e comentários."""
    i, n, depth, opened, last = 0, len(t), 0, False, None
    while i < n:
        c = t[i]
        if c == "\"":
            j = i + 1
            while j < n and t[j] != "\"":
                j += 2 if t[j] == "\\" else 1
            if j >= n or depth == 0:
                return None
            last, i = j, j + 1
            continue
        if t.startswith("//", i):
            j = t.find("\n", i)
            i = n if j < 0 else j
            continue
        if t.startswith("/*", i):
            j = t.find("*/", i + 2)
            if j < 0:
                return None
            i = j + 2
            continue
        if c.isspace():
            i += 1
            continue
        if depth == 0:
            if opened or c != "{":
                return None
            opened, depth, last = True, 1, i
        elif c in "{[":
            depth += 1
            last = i
        elif c in "}]":
            depth -= 1
            if depth == 0:
                rest = re.sub(r"//[^\n]*|/\*.*?\*/|\s", "", t[i + 1:], flags=re.S)
                return (i, last) if rest == "" else None
            last = i
        else:
            last = i
        i += 1
    return None


# O mesmo que o menu do Omarchy faz antes do JSON.parse (MenuModel.js):
# tira as linhas que são só comentário e as vírgulas finais. O resultado tem
# de passar por aqui, senão o Omarchy deixava de ler o menu inteiro.
def omarchy_parse(t):
    t = re.sub(r"^\s*//[^\n]*(\n|$)", "", t, flags=re.M)
    t = re.sub(r",(\s*[}\]])", r"\1", t)
    return json.loads(t)


if not text.strip():
    text = "{\n}\n"
try:
    original = omarchy_parse(text)
except ValueError:
    sys.exit(4)
if not isinstance(original, dict) or isinstance(original.get("items"), dict):
    # Com "items" o Omarchy só lê o que está lá dentro; entradas na raiz
    # seriam ignoradas em silêncio.
    sys.exit(4)

pos = root_close(text)
if pos is None:
    sys.exit(4)
close, last = pos
head, tail = text[:close], text[close:]
if head[last] not in "{,":
    head = head[: last + 1] + "," + head[last + 1:]
head = head.rstrip(" \t")
if not head.endswith("\n"):
    head += "\n"
result = head + block + "\n" + tail
if not result.endswith("\n"):
    result += "\n"

try:
    parsed = omarchy_parse(result)
except ValueError:
    sys.exit(4)
if not isinstance(parsed, dict) or any(parsed.get(k) != v for k, v in original.items()):
    sys.exit(4)
sys.stdout.write(result)
'

# --------------------------------------------- API nao-interativa (painel QML)

# save --id <id|vazio> --name .. --group .. --host .. --port .. --user ..
#      --auth key|password --identity .. --options ..
# Imprime o id resultante.
api_save() {
  local id="" name="" group="" host="" port="22" user="root" auth="key" identity="" options=""
  while (($#)); do
    case "$1" in
    --id) need_value "$@" || return 2; id="${2-}"; shift 2 ;;
    --name) need_value "$@" || return 2; name="${2-}"; shift 2 ;;
    --group) need_value "$@" || return 2; group="${2-}"; shift 2 ;;
    --host) need_value "$@" || return 2; host="${2-}"; shift 2 ;;
    --port) need_value "$@" || return 2; port="${2-}"; shift 2 ;;
    --user) need_value "$@" || return 2; user="${2-}"; shift 2 ;;
    --auth) need_value "$@" || return 2; auth="${2-}"; shift 2 ;;
    --identity) need_value "$@" || return 2; identity="${2-}"; shift 2 ;;
    --options) need_value "$@" || return 2; options="${2-}"; shift 2 ;;
    *) printf '%s\n' "$(t unknown_arg "$(strip_cntrl "$1")")" >&2; return 2 ;;
    esac
  done
  store_lock || return 1
  id=$(write_server "$id" "$name" "$group" "$host" "$port" "$user" "$auth" "$identity" "$options") || return $?
  menu_sync >/dev/null 2>&1
  printf '%s\n' "$id"
}

api_delete() {
  local id="${1:-}"
  [[ -n $id ]] || { printf '%s\n' "$(t usage "upssh delete <id>")" >&2; return 2; }
  valid_id "$id" || { printf '%s\n' "$(t bad_id "$(strip_cntrl "$id")")" >&2; return 2; }
  server_exists "$id" || { printf '%s\n' "$(t not_found "$id")" >&2; return 1; }
  delete_server "$id" || return 1
  menu_sync >/dev/null 2>&1
}

# Lê a senha da primeira linha do stdin, para o painel não a passar por argv.
api_set_password() {
  local id="${1:-}" pw
  [[ -n $id ]] || { printf '%s\n' "$(t usage "upssh set-password <id>")" >&2; return 2; }
  valid_id "$id" || { printf '%s\n' "$(t bad_id "$(strip_cntrl "$id")")" >&2; return 2; }
  IFS= read -r pw || true
  [[ -n $pw ]] || { printf '%s\n' "$(t empty_pass_api)" >&2; return 2; }
  store_lock || return 1
  server_exists "$id" || { printf '%s\n' "$(t not_found "$id")" >&2; return 1; }
  set_password "$id" "$pw" || return 1
  jq --arg id "$id" '.servers |= map(if .id == $id then .auth = "password" else . end)' "$SERVERS" | save_servers
  menu_sync >/dev/null 2>&1
}

api_group_rename() {
  local old="${1:-}" new
  new=$(strip_cntrl "${2:-}")
  [[ -n $old && -n $new ]] || { printf '%s\n' "$(t usage "upssh group-rename <old> <new>")" >&2; return 2; }
  store_lock || return 1
  jq --arg o "$old" --arg n "$new" '.servers |= map(if .group == $o then .group = $n else . end) | .servers |= sort_by(.group, .name)' "$SERVERS" | save_servers || return 1
  menu_sync >/dev/null 2>&1
}

# Diz quais os ids que ja tem senha guardada, sem revelar as senhas.
# Requer a senha mestra (pinentry quando nao ha terminal).
api_has_password() {
  [[ -f $SECRETS ]] || { printf '[]\n'; return 0; }
  # Leitura pelo gpg-agent: com a senha mestra em cache não pede nada.
  secrets_read | jq -c --argjson stale "$(stale_ids)" 'keys - $stale' 2>/dev/null || printf '[]\n'
}

# O que o painel lê: só servidores bem formados, com o tamanho já limitado
# por ensure_store, e sem campos internos.
api_json() {
  jq -c '{version: (.version // 1),
          servers: [(.servers // [])[] | select(type == "object" and (.id | type) == "string")
                    | {id, name, group, host, port, user, auth, identity, options}]}' "$SERVERS"
}

# ------------------------------------------------------- exportar / importar

EXPORT_MAGIC="upssh-export"

# Com --stdin-pass a senha do ficheiro chega pela primeira linha do stdin, em
# vez de um pinentry: é como o painel gráfico a entrega, sem passar por argv.
STDIN_PASS=false

# export [--com-senhas] [--overwrite] [ficheiro]
# Sem senhas produz JSON legível; com senhas produz um .gpg simétrico cifrado
# com uma senha escolhida na exportação — deliberadamente separada da senha
# mestra, para o ficheiro poder viajar sem levar a chave do cofre consigo.
# Um ficheiro que já exista (ou um link) só é substituído com --overwrite.
cmd_export() {
  local with_secrets=false overwrite=false dest=""
  while (($#)); do
    case "$1" in
    --com-senhas | --with-passwords) with_secrets=true; shift ;;
    --stdin-pass) STDIN_PASS=true; shift ;;
    --overwrite) overwrite=true; shift ;;
    -*) printf '%s\n' "$(t unknown_arg "$(strip_cntrl "$1")")" >&2; return 2 ;;
    *) dest="$1"; shift ;;
    esac
  done

  local stamp payload
  stamp=$(date +%Y%m%d-%H%M%S)

  # Um diálogo de gravação pode devolver só a pasta; nesse caso inventa-se o
  # nome em vez de falhar com "é um directório".
  local ext
  [[ $with_secrets == true ]] && ext="gpg" || ext="json"
  # Se o nome tiver de ser inventado ou completado, já não é o ficheiro que
  # quem pediu --overwrite confirmou: nesse caso nada é substituído.
  [[ -n $dest ]] || dest="$HOME"
  if [[ -d $dest ]]; then
    dest="${dest%/}/upssh-$stamp.$ext"
    overwrite=false
  elif [[ $dest != *.json && $dest != *.gpg ]]; then
    dest="$dest.$ext"
    overwrite=false
  fi
  local dir
  dir=$(dirname -- "$dest")
  [[ -d $dir ]] || { err "$(t export_write_fail "$dest")"; return 1; }
  if [[ $overwrite != true && (-e $dest || -L $dest) ]]; then
    err "$(t export_exists "$dest")"
    return 1
  fi

  payload=$(jq --arg m "$EXPORT_MAGIC" --arg at "$(date -Is)" \
    '{magic: $m, version: 1, exportedAt: $at, servers: .servers}' "$SERVERS") || return 1

  local a=""
  if [[ $with_secrets == true ]]; then
    [[ -f $SECRETS ]] || { err "$(t vault_none)"; return 1; }
    local vault
    vault=$(secrets_read) || { err "$(t vault_open_fail)"; return 1; }
    # Só viajam as senhas dos servidores que vão no ficheiro, e nunca as
    # obsoletas. O cofre entra no jq por um pipe, não pelo argv.
    payload=$(jq --slurpfile v <(printf '%s' "$vault") --argjson stale "$(stale_ids)" '
      . as $p | . + {secrets: ($v[0] | with_entries(select(.key as $k
        | ($stale | index($k)) == null and any($p.servers[]; .id == $k))))}' <<<"$payload") || return 1
    unset vault

    local b
    if [[ $STDIN_PASS == true ]]; then
      IFS= read -r a || true
      b="$a"
    else
      a=$(ask_secret "$(t export_pass)") || return 1
      b=$(ask_secret "$(t export_pass_confirm)") || return 1
    fi
    [[ -n $a && $a == "$b" ]] || { err "$(t pass_mismatch)"; return 1; }
  fi

  # Escreve-se primeiro um temporário na pasta de destino (0600 pela umask),
  # e só depois ele toma o lugar do destino: sem janela com permissões
  # abertas, sem seguir um link que lá esteja e sem ficheiros a meio.
  local tmp
  tmp=$(mktemp "$dir/.upssh-export.XXXXXX") || { err "$(t export_write_fail "$dest")"; return 1; }
  if [[ $with_secrets == true ]]; then
    if ! printf '%s' "$payload" | gpg --quiet --batch --yes --pinentry-mode loopback \
      --passphrase-fd 3 --symmetric --cipher-algo AES256 --output "$tmp" 3<<<"$a" 9>&-; then
      rm -f "$tmp"
      err "$(t export_encrypt_fail)"
      return 1
    fi
  else
    printf '%s\n' "$payload" >"$tmp" || { rm -f "$tmp"; err "$(t export_write_fail "$dest")"; return 1; }
  fi
  if [[ $overwrite == true ]]; then
    mv -f -T -- "$tmp" "$dest" || { rm -f "$tmp"; err "$(t export_write_fail "$dest")"; return 1; }
  else
    # -n com renameat2(RENAME_NOREPLACE): se entretanto apareceu um
    # ficheiro no destino, o temporário fica e é apagado.
    mv -n -T -- "$tmp" "$dest" 2>/dev/null
    if [[ -e $tmp ]]; then
      rm -f "$tmp"
      err "$(t export_exists "$dest")"
      return 1
    fi
  fi

  if [[ $with_secrets == true ]]; then
    ok "$(t exported_secrets "$dest")"
  else
    ok "$(t exported_plain "$dest")"
  fi
  printf '%s\n' "$dest"
}

# Lê o ficheiro, decifrando se for .gpg. Ecoa o JSON, nunca mais do que
# MAX_FILE bytes (quem chama verifica se o limite foi atingido).
read_export_file() {
  local file="$1"
  # Pelo conteúdo, não pelo nome: um JSON em claro é lido tal como está e
  # tudo o resto é tratado como um ficheiro cifrado pelo gpg.
  if ! jq -e 'type == "object"' -- "$file" >/dev/null 2>&1; then
    local pass
    if [[ $STDIN_PASS == true ]]; then
      IFS= read -r pass || true
    else
      pass=$(ask_secret "$(t import_pass)") || return 1
    fi
    gpg --quiet --batch --yes --pinentry-mode loopback --passphrase-fd 3 \
      --decrypt -- "$file" 3<<<"$pass" 2>/dev/null 9>&- | head -c $((MAX_FILE + 1))
    ((PIPESTATUS[0] == 0 || PIPESTATUS[0] == 141)) || { err "$(t decrypt_fail)"; return 1; }
  else
    head -c $((MAX_FILE + 1)) -- "$file"
  fi
}

# Um ficheiro importado pode vir de outra pessoa. Destas opções ssh só se
# aceitam as que não correm comandos nem baixam a guarda ao ligar
# (ProxyCommand, LocalCommand, ForwardAgent, StrictHostKeyChecking... ficam
# todas de fora). Deixa o resultado em SAFE_OPTS_KEPT / SAFE_OPTS_DROPPED.
SAFE_SSH_KEYS=" hostkeyalgorithms pubkeyacceptedalgorithms pubkeyacceptedkeytypes kexalgorithms ciphers macs serveraliveinterval serveralivecountmax connecttimeout connectionattempts compression tcpkeepalive identitiesonly preferredauthentications passwordauthentication pubkeyauthentication kbdinteractiveauthentication addressfamily loglevel "

safe_options() {
  local -a toks=() kept=() dropped=()
  read -ra toks <<<"$1"
  local i=0 tok spec key
  while ((i < ${#toks[@]})); do
    tok=${toks[i]}
    case $tok in
    -4 | -6 | -C | -q | -v | -vv | -vvv)
      kept+=("$tok")
      ((i++))
      continue
      ;;
    -o) spec=${toks[i + 1]-}; ((i += 2)) ;;
    -o*) spec=${tok#-o}; ((i++)) ;;
    *) dropped+=("$tok"); ((i++)); continue ;;
    esac
    key=${spec%%=*}
    key=${key,,}
    if [[ $spec == *=* && -n $key && $SAFE_SSH_KEYS == *" $key "* ]]; then
      kept+=("-o$spec")
    else
      dropped+=("-o$spec")
    fi
  done
  SAFE_OPTS_KEPT="${kept[*]}"
  SAFE_OPTS_DROPPED="${dropped[*]}"
}

# import <ficheiro> [--conflito substituir|manter|copiar|perguntar] [--dry-run]
# Tudo é validado e decidido numa cópia em memória; servers.json é gravado
# uma única vez, no fim, e o cofre logo a seguir. Se o ficheiro traz senhas
# e o cofre não abre, nada é importado.
cmd_import() {
  local file="" policy="perguntar" dry=false
  while (($#)); do
    case "$1" in
    --conflito | --on-conflict) need_value "$@" || return 2; policy="${2-}"; shift 2 ;;
    --stdin-pass) STDIN_PASS=true; shift ;;
    --dry-run) dry=true; shift ;;
    -*) printf '%s\n' "$(t unknown_arg "$(strip_cntrl "$1")")" >&2; return 2 ;;
    *) file="$1"; shift ;;
    esac
  done
  case $policy in
  replace) policy=substituir ;;
  keep) policy=manter ;;
  copy) policy=copiar ;;
  ask) policy=perguntar ;;
  esac
  case $policy in
  substituir | manter | copiar | perguntar) ;;
  *) printf '%s\n' "$(t unknown_arg "$(strip_cntrl "$policy")")" >&2; return 2 ;;
  esac
  [[ -n $file ]] || { printf '%s\n' "$(t usage "upssh import <file>")" >&2; return 2; }
  [[ -d $file ]] && { err "$(t is_a_dir "$file")"; return 1; }
  [[ -f $file ]] || { err "$(t file_missing "$file")"; return 1; }
  if (($(stat -c %s -- "$file") > MAX_FILE)); then
    err "$(t import_too_big "$file")"
    return 1
  fi
  has_tty || [[ $policy != perguntar ]] || policy=manter

  local data
  data=$(read_export_file "$file") || return 1
  if ((${#data} > MAX_FILE)); then
    err "$(t import_too_big "$file")"
    return 1
  fi
  # Exactamente um objecto: dois JSON seguidos no mesmo ficheiro não passam.
  jq -e -s --arg m "$EXPORT_MAGIC" 'length == 1 and (.[0] | .magic == $m and (.servers | type == "array"))' <<<"$data" >/dev/null 2>&1 ||
    { err "$(t not_an_export)"; return 1; }

  # --dry-run: só diz que servidores do ficheiro já existem (um nome por
  # linha), para o painel mostrar os conflitos antes de importar.
  if [[ $dry == true ]]; then
    jq -r --slurpfile d <(printf '%s' "$data") "$JQ_CLEAN"'
      .servers as $cur | $d[0].servers[] | select(type == "object") | .id as $i
      | $cur[] | select(.id == $i) | .name | c' "$SERVERS"
    return 0
  fi

  store_lock || return 1
  local work total added=0 replaced=0 kept=0 copied=0 invalid=0
  work=$(cat "$SERVERS")
  total=$(jq '.servers | length' <<<"$data")
  local map='{}'   # id no ficheiro -> id final, para as senhas que vêm atrás

  local i
  for ((i = 0; i < total; i++)); do
    local -a f=()
    mapfile -t f < <(jq -r --argjson i "$i" "$JQ_CLEAN"'
      .servers[$i] | if type == "object" then
        (.id // "" | c), (.name // "" | c), (.group // "" | c), (.host // "" | c),
        (.port // 22 | c), (.user // "" | c), (.auth // "key" | c),
        (.identity // "" | c), (.options // "" | c)
      else empty end' <<<"$data")
    if ((${#f[@]} != 9)); then
      warn "$(t import_invalid "$((i + 1))" "?")"
      ((invalid++))
      continue
    fi
    local origid="${f[0]}" id="${f[0]}" name="${f[1]}" group="${f[2]}" host="${f[3]}" port="${f[4]}"
    local user="${f[5]}" auth="${f[6]}" identity="${f[7]}" options="${f[8]}"
    local bad=""
    [[ -n ${name//[[:space:]]/} ]] || bad="name"
    valid_endpoint "$host" || bad="host"
    valid_endpoint "$user" || bad="user"
    valid_port "$port" || bad="port"
    if [[ -n $bad ]]; then
      warn "$(t import_invalid "$((i + 1))" "$bad")"
      ((invalid++))
      continue
    fi
    port=$((10#$port))
    [[ $auth == password ]] || auth=key
    [[ $auth == key ]] || identity=""
    [[ -n ${group//[[:space:]]/} ]] || group="Geral"
    safe_options "$options"
    options=$SAFE_OPTS_KEPT
    [[ -z $SAFE_OPTS_DROPPED ]] || warn "$(t import_opts_dropped "$name" "$SAFE_OPTS_DROPPED")"

    local action="adicionar" exists=false
    valid_id "$id" || id=""
    if [[ -n $id ]] && jq -e --arg id "$id" 'any(.servers[]; .id == $id)' >/dev/null <<<"$work"; then
      exists=true
    fi
    if [[ $exists == true ]]; then
      case "$policy" in
      substituir | manter | copiar) action=$policy ;;
      *)
        local cur choice
        cur=$(jq -c --arg id "$id" '.servers[] | select(.id == $id)' <<<"$work")
        warn "$(t conflict_on "$name" "$id")"
        t conflict_current "$(jq -r "$JQ_CLEAN"' (.user|c) + "@" + (.host|c) + ":" + (.port|c) + "  [" + (.group|c) + "]"' <<<"$cur")"
        t conflict_incoming "$user@$host:$port  [$group]"
        local -a ckeys=(c_replace c_keep c_copy c_replace_all c_keep_all c_copy_all) clabels=()
        local k
        for k in "${ckeys[@]}"; do clabels+=("$(t "$k")"); done
        choice=$(printf '%s\n' "${clabels[@]}" | gum choose --header "$(t c_what)" --height 8) || return 1
        case "$choice" in
        "${clabels[0]}") action=substituir ;;
        "${clabels[1]}") action=manter ;;
        "${clabels[2]}") action=copiar ;;
        "${clabels[3]}") action=substituir; policy=substituir ;;
        "${clabels[4]}") action=manter; policy=manter ;;
        "${clabels[5]}") action=copiar; policy=copiar ;;
        esac
        ;;
      esac
    elif [[ -z $id ]] || id_taken "$id" "$work"; then
      # Id inválido, ou ocupado por uma senha obsoleta: entra com um id novo.
      id=""
    fi

    local has_secret=false
    if [[ $auth == password ]] && jq -e --arg k "$origid" '.secrets[$k]? | type == "string"' >/dev/null 2>&1 <<<"$data"; then
      has_secret=true
    fi

    case "$action" in
    manter) ((kept++)); continue ;;
    copiar) id=""; ((copied++)) ;;
    substituir)
      ((replaced++))
      # O destino mudou e o ficheiro não traz senha nova: a senha guardada
      # não pode seguir para o host novo.
      if [[ $has_secret == false ]] && ! jq -e --arg id "$id" --arg h "$host" --arg u "$user" --argjson p "$port" \
        '.servers[] | select(.id == $id) | .host == $h and .user == $u and .port == $p' >/dev/null <<<"$work"; then
        work=$(jq -c --arg id "$id" '.staleSecrets = (((.staleSecrets // []) + [$id]) | unique)' <<<"$work")
        warn "$(t import_pass_dropped "$name")"
      fi
      ;;
    adicionar) ((added++)) ;;
    esac
    [[ -n $id ]] || id=$(new_id "$name" "$work")

    work=$(jq -c --arg id "$id" --arg name "$name" --arg group "$group" --arg host "$host" \
      --argjson port "$port" --arg user "$user" --arg auth "$auth" \
      --arg identity "$identity" --arg options "$options" '
        .servers = ((.servers // []) | map(select(.id != $id))) + [{
          id: $id, name: $name, group: $group, host: $host, port: $port,
          user: $user, auth: $auth, identity: $identity, options: $options
        }] | .servers |= sort_by(.group, .name)' <<<"$work")
    [[ $has_secret == true ]] && map=$(jq -c --arg from "$origid" --arg to "$id" '.[$from] = $to' <<<"$map")
  done

  local nsecrets
  nsecrets=$(jq 'length' <<<"$map")
  if ((nsecrets > 0)); then
    unlock || { err "$(t import_need_vault)"; return 1; }
  fi
  printf '%s' "$work" | save_servers || return 1
  if ((nsecrets > 0)); then
    # As senhas vão do ficheiro para o cofre sem passar pelo argv.
    vault_update '. * ($d[0].secrets as $s | $map | with_entries({key: .value, value: $s[.key]}))' \
      --slurpfile d <(printf '%s' "$data") --argjson map "$map" ||
      { err "$(t import_pass_fail)"; return 1; }
  fi

  menu_sync >/dev/null 2>&1
  ok "$(t import_summary "$total" "$added" "$replaced" "$copied" "$((kept + invalid))")"
}

# ------------------------------------------------------------------------ TUI

tui_export() {
  local with=""
  if gum confirm "$(t export_with_pass)" --default=no; then
    with="--com-senhas"
  fi
  cmd_export $with
  gum input --placeholder "$(t enter_back)" >/dev/null
}

tui_import() {
  local file
  file=$(gum file "$HOME" --height 15) || return 0
  [[ -n $file ]] || return 0
  cmd_import "$file"
  gum input --placeholder "$(t enter_back)" >/dev/null
}

choose_lang() {
  local sel
  sel=$(printf 'Português\nEnglish\n' | gum choose --header "$(t m_lang)") || return 0
  case "$sel" in
  Português) set_lang pt ;;
  English) set_lang en ;;
  esac
  ok "$(t lang_set)"
}

# As entradas são escolhidas por índice, não pelo texto: assim o menu continua
# a funcionar em qualquer idioma sem casos especiais por tradução.
manage_menu() {
  local -a keys=(m_add m_edit m_remove m_pass m_move m_rename m_listall
                 m_export m_import m_sync m_master m_lang m_back)
  local -a icons=($'\uf067' $'\uf044' $'\uf1f8' $'\uf084' $'\uf0b2' $'\uf02b'
                  $'\uf03a' $'\uf019' $'\uf093' $'\uf021' $'\uf023' $'\uf0ac' $'\uf060')
  while :; do
    local -a labels=()
    local i sel idx=-1
    for i in "${!keys[@]}"; do labels+=("${icons[$i]:- }  $(t "${keys[$i]}")"); done
    sel=$(printf '%s\n' "${labels[@]}" | gum choose --header "$(t m_manage)" --height 13) || return 0
    for i in "${!labels[@]}"; do [[ ${labels[$i]} == "$sel" ]] && idx=$i; done
    ((idx >= 0)) || continue
    case "${keys[$idx]}" in
    m_add) server_form "" ;;
    m_edit)
      local id
      id=$(pick_server_id "" "$(t which_edit)") && server_form "$id"
      ;;
    m_remove) remove_server ;;
    m_pass) set_server_password ;;
    m_move) move_server_group ;;
    m_rename) rename_group ;;
    m_listall)
      cmd_list
      gum input --placeholder "$(t enter_back)" >/dev/null
      ;;
    m_export) tui_export ;;
    m_import) tui_import ;;
    m_sync) menu_sync && ok "$(t menu_synced)" ;;
    m_master) change_master ;;
    m_lang) choose_lang ;;
    m_back) return 0 ;;
    esac
    # Entre acções a TUI fica à espera do utilizador; o painel não pode
    # ficar bloqueado por isso.
    store_unlock
  done
}

tui() {
  ensure_store
  if [[ -f $PENDING ]]; then
    warn "$(t pending_wait)"
    if gum confirm "$(t pending_ask)" --default=yes; then
      vault_init || true
    fi
    store_unlock
  fi
  while :; do
    local -a opts=()
    mapfile -t opts < <(groups_list)
    if ((${#opts[@]} == 0)); then
      warn "$(t no_servers_yet)"
      manage_menu
      continue
    fi
    local ngroups=${#opts[@]}
    opts+=("  $(t m_all)" "  $(t m_manage_short)" "  $(t m_quit)")
    local sel idx=-1 i
    sel=$(printf '%s\n' "${opts[@]}" | gum choose --header "$(t pick_group)" --height 14) || break
    for i in "${!opts[@]}"; do [[ ${opts[$i]} == "$sel" ]] && idx=$i; done
    if ((idx == ngroups + 2)); then
      break
    elif ((idx == ngroups + 1)); then
      manage_menu
    elif ((idx == ngroups)); then
      local id
      id=$(pick_server_id "" "$(t pick_server_all)") && cmd_connect "$id"
    else
      local id
      id=$(pick_server_id "$sel" "$(t pick_server_group "$sel")") && cmd_connect "$id"
    fi
    store_unlock
  done
}

# ---------------------------------------------------------------------- entry

require jq gum ssh gpg python3 flock
ensure_store

case "${1:-}" in
connect)
  shift
  cmd_connect "$@"
  ;;
add) server_form "" ;;
edit)
  shift
  id="${1:-}"
  [[ -n $id ]] || id=$(pick_server_id "" "$(t which_edit)") || exit 1
  valid_id "$id" && server_exists "$id" || die "$(t not_found "$(strip_cntrl "$id")")"
  server_form "$id"
  ;;
remove | rm) remove_server ;;
list | ls) cmd_list ;;
passwd) set_server_password ;;
groups) groups_list ;;
menu-sync) menu_sync && printf "%s\n" "$(t menu_synced)" ;;
json) api_json ;;
save)
  shift
  api_save "$@"
  ;;
delete)
  shift
  api_delete "$@"
  ;;
set-password)
  shift
  api_set_password "$@"
  ;;
group-rename)
  shift
  api_group_rename "$@"
  ;;
has-password) api_has_password ;;
link)
  # Quem instalou pelo `omarchy plugin add` tem o comando dentro da pasta do
  # plugin; isto põe-no ao alcance do terminal sem copiar nada. Um ficheiro
  # alheio com o mesmo nome nunca é substituído.
  shift
  target="$HOME/.local/bin/upssh"
  if [[ ${1:-} == --name ]]; then
    [[ ${2:-} =~ ^[A-Za-z0-9._-]+$ ]] || die "$(t usage "upssh link --name <name>")"
    target="$HOME/.local/bin/$2"
  fi
  if [[ -e $target || -L $target ]] && ! upssh_owns "$target"; then
    printf '%s\n' "$(t link_foreign "$target")" >&2
    exit 1
  fi
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$SELF" "$target"
  printf '%s -> %s\n' "$target" "$SELF"
  ;;
lang)
  shift
  if [[ -n ${1:-} ]]; then set_lang "$1"; else printf '%s\n' "$UPSSH_LANG"; fi
  ;;
export)
  shift
  cmd_export "$@"
  ;;
import)
  shift
  cmd_import "$@"
  ;;
vault-init) vault_init ;;
master) change_master ;;
-h | --help | help)
  if [[ $UPSSH_LANG == pt ]]; then
    cat <<'USAGE_PT'
upSSH — gestor de acessos SSH para o Omarchy

  upssh                       Abre a TUI (grupo → servidor → liga)
  upssh connect <id>          Liga directamente a um servidor
  upssh add                   Cadastra um servidor
  upssh edit [id]             Edita um servidor
  upssh remove                Remove um servidor
  upssh list                  Lista todos os servidores
  upssh passwd                Define/altera a senha de um servidor
  upssh groups                Lista os grupos
  upssh export [--com-senhas] [--overwrite] [ficheiro]
                              Exporta os servidores (JSON), ou um .gpg cifrado;
                              nunca substitui um ficheiro sem --overwrite
  upssh import <ficheiro> [--conflito substituir|manter|copiar|perguntar] [--dry-run]
                              Importa servidores de uma exportação (só opções
                              ssh seguras são aceites de um ficheiro)
  upssh lang [pt|en]          Mostra ou altera o idioma
  upssh menu-sync             Regenera as entradas no menu do Omarchy
  upssh vault-init            Cria o cofre e importa senhas pendentes
  upssh master                Altera a senha mestra do cofre

Ficheiros:
  ~/.config/upssh/servers.json   servidores (sem senhas)
  ~/.config/upssh/secrets.gpg    senhas (GPG AES-256, senha mestra)
  ~/.config/upssh/config.json    preferências (idioma)
USAGE_PT
  else
    cat <<'USAGE_EN'
upSSH — SSH access manager for Omarchy

  upssh                       Open the TUI (group → server → connect)
  upssh connect <id>          Connect straight to a server
  upssh add                   Register a server
  upssh edit [id]             Edit a server
  upssh remove                Remove a server
  upssh list                  List every server
  upssh passwd                Set or change a server password
  upssh groups                List the groups
  upssh export [--with-passwords] [--overwrite] [file]
                              Export the servers (JSON), or an encrypted .gpg;
                              never replaces a file without --overwrite
  upssh import <file> [--on-conflict replace|keep|copy|ask] [--dry-run]
                              Import servers from an export (only safe ssh
                              options are accepted from a file)
  upssh lang [pt|en]          Show or change the language
  upssh menu-sync             Regenerate the Omarchy menu entries
  upssh vault-init            Create the vault and import pending passwords
  upssh master                Change the vault master password

Files:
  ~/.config/upssh/servers.json   servers (no passwords)
  ~/.config/upssh/secrets.gpg    passwords (GPG AES-256, master password)
  ~/.config/upssh/config.json    preferences (language)
USAGE_EN
  fi
  ;;
"") tui ;;
*) die "$(t unknown_cmd "$1")" ;;
esac
